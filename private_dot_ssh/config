Include config.d/*.conf

Host boss
  HostName boss.home.arpa
  ForwardAgent yes

Host dgx1
  HostName dgx1.home.arpa
  ForwardAgent yes
  LocalForward 11000 localhost:11000

Host hermes
  HostName hermes.home.arpa
  User hermes
  ForwardAgent no
  LocalForward 9119 localhost:9119

Host *.home.arpa
  ForwardAgent yes

Host *
  User james
  ControlPath ~/.ssh/%C
  ControlMaster auto
  ControlPersist 15s
  PermitLocalCommand yes
  LocalCommand ~/.scripts/ssh-title.fish %h

# Fall back to a locally-installed 1Password agent only when the environment
# has no live agent socket. Covers herdr panes (no SSH_TTY), SSH logins with
# forwarded agents, and local consoles without one.
Match host * exec "test ! -S \"$SSH_AUTH_SOCK\""
  IdentityAgent ~/.1password/agent.sock
