// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_ui_font_size": 19.0,
  "agent_buffer_font_size": 16.0,
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "agent": {
    "sandbox_permissions": {
      "allow_all_hosts": true,
      "allow_unsandboxed": false,
      "write_paths": [
        {
          "requested": "/home/james/.cargo",
          "resolved": "/home/james/.cargo"
        }
      ],
      "network_hosts": [
        "static.crates.io",
        "crates.io",
        "index.crates.io"
      ]
    },
    "tool_permissions": {
      "tools": {
        "terminal": {
          "always_allow": [
            {
              "pattern": "^cargo\\s"
            },
            {
              "pattern": "^make\\s+sqlx-metadata(\\s|$)"
            },
            {
              "pattern": "^make\\s+sqlx-check(\\s|$)"
            },
            {
              "pattern": "^git\\b"
            }
          ]
        }
      }
    },
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "openai",
      "model": "gpt-5.6-terra",
    },
  },
  "indent_guides": {
    "coloring": "indent_aware",
  },
  "vim_mode": true,
  "ui_font_size": 18,
  "buffer_font_size": 17,
  "buffer_font_family": "Fira Code",
  "theme": {
    "mode": "dark",
    "light": "Nightfox - opaque",
    "dark": "Ayu Dark",
  },
  "relative_line_numbers": "enabled",
  "languages": {
    "Rust": {
      "show_wrap_guides": true,
      "soft_wrap": "editor_width",
    },
  },
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": false,
        "check": {
          "command": "clippy",
        },
      },
    },
  },
}
