{
  "meta": {
    "name": "pi",
    "version": "1.0.0",
    "description": "Pi coding agent"
  },
  "groups": {
    "include": [
      "git_config",
      "go_runtime",
      "nix_runtime",
      "node_runtime",
      "python_runtime",
      "rust_runtime",
      "user_caches_linux"
    ]
  },
  "filesystem": {
    "allow": [
      "/tmp",
      "~/.bun",
      "~/.cargo",
      "~/.config/go",
      "~/.npm",
      "~/.npm-global",
      "~/.pi",
      "~/.plannotator",
      "~/devel/planning",
      "~/go"
    ],
    "read": [
      "/etc",
      "/proc",
      "~/.local/share/gh/extensions",
      "~/devel/pi-plugins"
    ],
    "allow_file": [
      "~/.gitconfig",
      "~/.ssh/known_hosts",
      "~/.config/orca/agent-hooks/endpoint.env",
      "~/.yarnrc"
    ],
    "read_file": [
      "/proc/sys/vm/overcommit_memory",
      "/proc/version_signature",
      "~/.config/gh/config.yml",
      "~/.config/gh/hosts.yml",
      "~/.cvsignore"
    ],
    "bypass_protection": [
      "~/.ssh/known_hosts"
    ]
  },
  "network": {
    "block": false,
    "allow_http2": false,
    "allow_domain": [],
    "deny_domain": [],
    "open_port": [],
    "open_port_range": [],
    "listen_port": [
      9999
    ],
    "listen_port_range": [],
    "connect_port": [],
    "no_proxy": [],
    "custom_credentials": {},
    "tls_intercept": null,
    "upstream_proxy": null,
    "upstream_bypass": []
  },
  "workdir": {
    "access": "readwrite"
  }
}
